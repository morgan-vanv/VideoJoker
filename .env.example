# Copy this file to .env (the real bot) or .env.dev (your test bot) and fill it in.
# Never commit .env or .env.dev: they hold your bot's password (the token). Both are gitignored.

# Bot tab of your application in https://discord.com/developers/applications -> Reset Token
DISCORD_TOKEN=paste_your_bot_token_here

# Your own Discord user ID (Developer Mode on -> right-click yourself -> Copy User ID).
# The owner is always VIP.
OWNER=your_numeric_user_id

# Dev bot only (.env.dev): your private test server's ID (right-click the server -> Copy Server ID).
# Commands then appear instantly in that server only. Leave it out for the real bot.
# DEV_GUILD_ID=your_test_server_id

# OSRS drop flexing (optional). The channel Dink posts drops and other notifications in (on our server:
# #automated-rs-flexing): right-click the channel -> Copy Channel ID.
# The bot makes and manages the webhooks itself, so it needs the Manage Webhooks permission.
# OSRS_FLEXING_CHANNEL_ID=your_flexing_channel_id
# Optional: a channel for deaths (on our server: #everyone-point-and-laugh). /osrs register then asks each
# player whether they want their deaths posted there, through a second webhook named "sit, respectfully".
# OSRS_DEATHS_CHANNEL_ID=your_deaths_channel_id

# Event alerts (optional): how long before each Discord event the VJ posts a reminder, comma-separated, using
# d (days), h (hours) or m (minutes). Left out, it's 24h,1h. Each server picks its channel with /seteventalerts.
# EVENT_ALERT_TIMES=24h,1h
