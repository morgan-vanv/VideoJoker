# Copy this file to .env (the real bot) or .env.dev (your test bot) and fill it in.
# Never commit .env or .env.dev: they hold your bot's password (the token). Both are gitignored.

# Bot tab of your application in https://discord.com/developers/applications -> Reset Token
DISCORD_TOKEN=paste_your_bot_token_here

# Your own Discord user ID (Developer Mode on -> right-click yourself -> Copy User ID).
# The owner is always VIP.
OWNER=your_numeric_user_id

# Dev bot only (.env.dev): your private test server's ID (right-click the server -> Copy Server ID).
# Commands then appear instantly in that server only. Leave it out for the real bot.
# DEV_GUILD_ID=your_test_server_id
